rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasSharedFridgeAccess(ownerUserId) {
      return signedIn()
      && exists(/databases/$(database)/documents/users/$(request.auth.uid)/sharedFridges/$(ownerUserId));
    }

    function canUseFridge(ownerUserId) {
      return ownsUserDocument(ownerUserId) || hasSharedFridgeAccess(ownerUserId);
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly([
        'email',
        'emailLower',
        'createdAt',
        'updatedAt',
      ])
      && request.resource.data.email is string
      && request.resource.data.email.size() > 0
      && (
        !('emailLower' in request.resource.data)
        || request.resource.data.emailLower is string
      )
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    function validFridgeDocument() {
      return request.resource.data.keys().hasOnly([
        'name',
        'createdAt',
        'updatedAt',
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    function validFridgeItem() {
      return request.resource.data.keys().hasOnly([
        'name',
        'category',
        'addedDate',
        'expiryDate',
        'source',
        'imageUrl',
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.category is string
      && request.resource.data.category.size() > 0
      && request.resource.data.addedDate is timestamp
      && request.resource.data.expiryDate is timestamp
      && request.resource.data.source is string
      && request.resource.data.source in ['manual', 'scan', 'barcode']
      && (
        !('imageUrl' in request.resource.data)
        || request.resource.data.imageUrl == null
        || request.resource.data.imageUrl is string
      );
    }

    function validSharedFridgeDocument(ownerUserId) {
      return request.resource.data.keys().hasOnly([
        'ownerId',
        'ownerEmail',
        'fridgeName',
        'sharedAt',
      ])
      && request.resource.data.ownerId == ownerUserId
      && request.resource.data.ownerEmail is string
      && request.resource.data.fridgeName is string
      && request.resource.data.sharedAt is timestamp;
    }

    function validMemberDocument(memberUserId) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'sharedAt',
      ])
      && request.resource.data.uid == memberUserId
      && request.resource.data.email is string
      && request.resource.data.email.size() > 0
      && request.resource.data.sharedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsUserDocument(userId) && validUserDocument();
      allow delete: if false;

      match /sharedFridges/{ownerUserId} {
        allow read: if ownsUserDocument(userId);
        allow create, update: if signedIn()
          && request.auth.uid == ownerUserId
          && validSharedFridgeDocument(ownerUserId);
        allow delete: if ownsUserDocument(userId) || ownsUserDocument(ownerUserId);
      }

      match /fridges/{fridgeId} {
        allow read: if canUseFridge(userId);
        allow create, update: if ownsUserDocument(userId) && validFridgeDocument();
        allow delete: if false;

        match /items/{itemId} {
          allow read: if canUseFridge(userId);
          allow create, update: if canUseFridge(userId) && validFridgeItem();
          allow delete: if canUseFridge(userId);
        }

        match /members/{memberUserId} {
          allow read: if canUseFridge(userId);
          allow create, update: if ownsUserDocument(userId)
            && validMemberDocument(memberUserId);
          allow delete: if ownsUserDocument(userId);
        }
      }
    }
  }
}

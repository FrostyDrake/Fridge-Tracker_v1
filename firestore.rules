rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasSharedFridgeAccess(ownerUserId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(ownerUserId)/fridges/default/members/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/sharedFridges/$(ownerUserId));
    }

    function canUseFridge(userId) {
      return ownsUserDocument(userId) || hasSharedFridgeAccess(userId);
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly([
        'email',
        'emailLower',
        'createdAt',
        'updatedAt',
        'householdId',
      ])
      && request.resource.data.email is string
      && request.resource.data.email.size() > 0
      && request.resource.data.emailLower is string
      && request.resource.data.emailLower.size() > 0
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp
      && (
        !('householdId' in request.resource.data)
        || request.resource.data.householdId is string
      );
    }

    function validFridgeDocument() {
      return request.resource.data.keys().hasOnly([
        'name',
        'createdAt',
        'updatedAt',
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 30
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    function validFridgeItemBase(data) {
      return data.keys().hasOnly([
        'name',
        'category',
        'addedDate',
        'expiryDate',
        'source',
        'imageUrl',
      ])
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 100
      && data.category is string
      && data.category.size() > 0
      && data.category.size() <= 100
      && data.expiryDate is timestamp
      && (
        !('source' in data)
        || data.source in ['manual', 'scan', 'barcode']
      )
      && (
        !('imageUrl' in data)
        || data.imageUrl == null
        || data.imageUrl is string
      );
    }

    function validFridgeItemCreate() {
      return validFridgeItemBase(request.resource.data)
        && request.resource.data.addedDate is timestamp;
    }

    function validFridgeItemUpdate() {
      return validFridgeItemBase(request.resource.data)
        && (
          !('addedDate' in request.resource.data)
          || request.resource.data.addedDate is timestamp
        )
        && (
          !('addedDate' in resource.data)
          || resource.data.addedDate == request.resource.data.addedDate
        );
    }

    function validSharedFridgeDocument(userId, ownerUserId) {
      return signedIn()
      && request.auth.uid == ownerUserId
      && userId != ownerUserId
      && request.resource.data.keys().hasOnly([
        'ownerId',
        'ownerEmail',
        'fridgeName',
        'sharedAt',
      ])
      && request.resource.data.ownerId == ownerUserId
      && request.resource.data.ownerEmail is string
      && request.resource.data.ownerEmail.size() > 0
      && request.resource.data.fridgeName is string
      && request.resource.data.fridgeName.size() > 0
      && request.resource.data.sharedAt is timestamp;
    }

    function validSharedMemberDocument(memberId) {
      return signedIn()
      && request.auth.uid != memberId
      && request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'sharedAt',
      ])
      && request.resource.data.uid == memberId
      && request.resource.data.email is string
      && request.resource.data.email.size() > 0
      && request.resource.data.sharedAt is timestamp;
    }

    function validFcmTokenDocument() {
      return request.resource.data.keys().hasOnly([
        'token',
        'platform',
        'updatedAt',
      ])
      && request.resource.data.token is string
      && request.resource.data.token.size() > 0
      && request.resource.data.platform is string
      && request.resource.data.platform.size() > 0
      && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if ownsUserDocument(userId);
      allow list: if signedIn() && request.query.limit <= 1;
      allow create, update: if ownsUserDocument(userId) && validUserDocument();
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, delete: if ownsUserDocument(userId);
        allow create, update: if ownsUserDocument(userId)
          && validFcmTokenDocument();
      }

      match /sharedFridges/{ownerUserId} {
        allow read: if ownsUserDocument(userId);
        allow create, update: if validSharedFridgeDocument(userId, ownerUserId);
        allow delete: if ownsUserDocument(userId) || request.auth.uid == ownerUserId;
      }

      match /fridges/{fridgeId} {
        allow read: if canUseFridge(userId);
        allow create, update: if ownsUserDocument(userId) && validFridgeDocument();
        allow delete: if false;

        match /members/{memberId} {
          allow read: if canUseFridge(userId);
          allow create, update: if ownsUserDocument(userId)
            && validSharedMemberDocument(memberId);
          allow delete: if ownsUserDocument(userId) || ownsUserDocument(memberId);
        }

        match /items/{itemId} {
          allow read: if canUseFridge(userId);
          allow create: if canUseFridge(userId)
            && validFridgeItemCreate();
          allow update: if canUseFridge(userId)
            && validFridgeItemUpdate();
          allow delete: if canUseFridge(userId);
        }
      }
    }
  }
}
